/* Etiqueta: Sumatoria 2 */
PROC SQL;
CREATE TABLE WORK.TOTAL_EXTERIOR
AS
SELECT SUM(RESULTADO_AHO_EXT.FIN_SALDO_CTA) FORMAT=BEST20.
AS FIN_SAL_CTA, SUM(RESULTADO_AHO_EXT.PROM_SALDO_CTA) FORMAT=BEST20.
AS PROM_SAL_CTA, SUM(RESULTADO_AHO_EXT.MED_SALDO_CTA) FORMAT=BEST20.
AS MED_SAL_CTA, SUM(RESULTADO_AHO_EXT.MAX_SALDO_CTA) FORMAT=BEST20.
AS MAX_SAL_CTA, SUM(RESULTADO_AHO_EXT.MIN_SALDO_CTA) FORMAT=BEST20.
AS MIN_SAL_CTA, SUM(RESULTADO_AHO_EXT.VAL_CRED_MES) FORMAT=BEST20.
AS VAL_CRED_MES, SUM(RESULTADO_AHO_EXT.NRO_CRED_MES) FORMAT=BEST20.
AS NRO_CRED_MES, SUM(RESULTADO_AHO_EXT.PROM_CRED_MES) FORMAT=BEST20.
AS PROM_CRED_MES, SUM(RESULTADO_AHO_EXT.MED_CRED_MES) FORMAT=BEST20.
AS MED_CRED_MES, SUM(RESULTADO_AHO_EXT.VAL_DEB_MES) FORMAT=BEST20.
AS VAL_DEB_MES, SUM(RESULTADO_AHO_EXT.NRO_DEB_MES) FORMAT=BEST20.
AS NRO_DEB_MES, SUM(RESULTADO_AHO_EXT.PROM_DEB_MES) FORMAT=BEST20.
AS PROM_DEB_MES
FROM WORK.RESULTADO_AHO_EXT;
QUIT;

/* Etiqueta: Sumatoria 1 */
PROC SQL;
CREATE TABLE WORK.TOTAL_NACIONAL
AS
SELECT SUM(RESULTADO_AHO_NAL.FIN_SALDO_CTA) FORMAT=BEST20.
AS FIN_SAL_CTA, SUM(RESULTADO_AHO_NAL.PROM_SALDO_CTA) FORMAT=BEST20.
AS PROM_SAL_CTA, SUM(RESULTADO_AHO_NAL.MED_SALDO_CTA) FORMAT=BEST20.
AS MED_SAL_CTA, SUM(RESULTADO_AHO_NAL.MAX_SALDO_CTA) FORMAT=BEST20.
AS MAX_SAL_CTA, SUM(RESULTADO_AHO_NAL.MIN_SALDO_CTA) FORMAT=BEST20.
AS MIN_SAL_CTA, SUM(RESULTADO_AHO_NAL.VAL_CRED_MES) FORMAT=BEST20.
AS VAL_CRED_MES, SUM(RESULTADO_AHO_NAL.NRO_CRED_MES) FORMAT=BEST20.
AS NRO_CRED_MES, SUM(RESULTADO_AHO_NAL.PROM_CRED_MES) FORMAT=BEST20.
AS PROM_CRED_MES, SUM(RESULTADO_AHO_NAL.MED_CRED_MES) FORMAT=BEST20.
AS MED_CRED_MES, SUM(RESULTADO_AHO_NAL.VAL_DEB_MES) FORMAT=BEST20.
AS VAL_DEB_MES, SUM(RESULTADO_AHO_NAL.NRO_DEB_MES) FORMAT=BEST20.
AS NRO_DEB_MES, SUM(RESULTADO_AHO_NAL.PROM_DEB_MES) FORMAT=BEST20.
AS PROM_DEB_MES
FROM WORK.RESULTADO_AHO_NAL;
QUIT;
