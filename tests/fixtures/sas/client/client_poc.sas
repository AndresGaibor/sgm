%if (&i eq &num_splits) %then
%syslput obs = %str() / remote = sessio&i;
%else
%syslput obs = %str(obs=&obs) / remote = sessio&i;

/* 3. Inicia la ejecucion de la sesion */
rsubmit sessio&i wait=no                  /*Inicio rsubmit */
inheritlib = (liborg=wliborg work=pwork);

/* almacena las tablas temporales en work */
options validvarname=any;

data pwork.&tbltmp.&sessio.(compress=binary);
set wliborg.&tabla_origen. (&firstobs &obs);
run;

endrsubmit;

/* Fin rsubmit */

%let firstobs = %eval(&firstobs + &numObsPerSession);
%let obs = %eval(&obs + &numObsPerSession);
%end;

/* Se espera la finalizacion de todas las sesiones */
waitfor _all_ 
%do i=1 %to &num_splits;
sessio&i
 %end;
;
