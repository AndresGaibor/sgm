%macro checkForErrors(pide);
options nosyntaxcheck nosymbolgen nosource nosource2 nomlogic nomprint;
%showMessage(msg=Escaneando errores de las ejecuciones en paralelo);

/* comando para la verificacion de errores de ejecucion en bulkload */
data _null_;
cmdprocess=cat("find &logsbl. -type f -iname '", "*&pide.*", 
"' | xargs grep -H -n -C 4 'ERROR:'");
call symputx('cmdprocess', cmdprocess, 'G');
run;

/* Ejecucion del programa por medio de pipe */
filename ps_list pipe "&cmdprocess";

/* captura la salida del comando ejecutado en SO */
data saserror;
infile ps_list truncover lrecl=32767;
length outcmd $ 32767;
input @1 outcmd $32767.;
run;

/* numero de errores */
proc sql noprint;
select count(outcmd) into: numprocess from saserror;
quit;

/* imprime los errores del/los bulkloads en la salida de SAS */
                                
%if %symexist(numprocess) %then
%do;

%if &numprocess gt 0 %then
%do;

proc sql noprint;
select max(length(outcmd)) into :MaxLen from saserror;
quit;

data _null_;
length MaxLen filelog deserr $ &MaxLen.;
set saserror;
filelog=scan(outcmd, 1, ":");

if index(outcmd, "ERROR:") gt 0 then
do;
deserr=substr(outcmd, index(outcmd, "ERROR:"));
put filelog;
put deserr;
call symputx('wsyserr', 1099, 'G');
end;
run;

%end;
%end;
%mend checkForErrors;

