%macro split3_(tabla_origen=, registros_por_chunk=4000000, prefix=);
options nosyntaxcheck nosymbolgen nosource nosource2 nomlogic nomprint nonotes;
%local total_registros num_chunks chunk_id;
%global spltables tablas wtbltmp workpath;
%showMessage(msg=Creando data chunks);
%let workpath=%sysfunc(cat(%sysfunc(pathname(work)), /));

/* 1. Verificar la tabla y obtener el número total de registros */
/* Utiliza la opción NOBS= en la sentencia SET para contar rápidamente */
data _null_;
set &tabla_origen nobs=total_obs;
call symputx('total_registros', total_obs);
stop;
run;

/* 2. Calcular el número total de fragmentos (Chunks) necesarios  CEILZ redondea hacia arriba el resultado de la división: */
%let num_chunks = %sysfunc(ceilz(%sysevalf(&total_registros / &registros_por_chunk)));
%put NOTE: Total de registros en &tabla_origen: &total_registros;
%put NOTE: Cantidad de chunks a crear: &num_chunks;
%put NOTE: Registros por chunk (aprox.): &registros_por_chunk;

/* 3. Lógica de Creación de los Data Chunks (Splits) */
/* El DATA step lee la tabla una vez y asigna cada registro a un chunk */
data 
%do i=1 %to &num_chunks;
work.&prefix.&i (compress=binary) %end;
;
set &tabla_origen;

/* _N_ es el número de la observación actual.
INT((_N_ - 1) / &registros_por_chunk) calcula el índice del chunk (empezando en 0).
+ 1 lo ajusta para que el chunk empiece en 1. */
chunk_id=int((_N_ - 1) / &registros_por_chunk) + 1;

/* 4. Sentencia Condicional para Output a la tabla correcta */

%do j=1 %to &num_chunks;

if chunk_id=&j then
output work.&prefix.&j;
%end;

/* Opcional: Eliminar la variable temporal chunk_id */
drop chunk_id;
run;

proc contents data=work._all_ noprint out=contents;
run;

proc sort data=contents out=members nodupkey;
by memname;
run;

proc sql noprint;
select memname into: tablas separated by "|" from members where 
upcase(memname) contains upcase("&wprefix.") order by crdate asc;
quit;

%let spltables=&tablas;
%put NOTE: Proceso de split completado. Tablas creadas: work.temp_chunk_1 hasta work.temp_chunk_&num_chunks;
%mend split3_;

%macro split3(tabla_origen=, registros_por_chunk=4000000, prefix=);
options nosyntaxcheck nosymbolgen nosource nosource2 nomlogic nomprint nonotes;
%showMessage(msg=Creando datachunks);
%local total_registros num_chunks chunk_id inicio fin;
%global spltables tablas wtbltmp workpath;
%let workpath=%sysfunc(cat(%sysfunc(pathname(work)), /));

/* 1. Verificar la tabla y obtener el número total de registros */
%let dsid = %sysfunc(open(&tabla_origen.));
%let total_registros = %sysfunc(attrn(&dsid, NLOBS));

/* Si la tabla no tiene observaciones no se realizan los splits */

%if (&total_registros eq 0) %then
%do;
%put ERROR%str(:) LA TABLA &tabla_origen. NO TIENE REGISTROS%nrstr(,) POR FAVOR VALIDAR;
%abort cancel;
%end;

/* 2. Calcular el número total de fragmentos (Chunks) necesarios */
%let num_chunks = %sysfunc(ceilz(%sysevalf(&total_registros / &registros_por_chunk)));
%put NOTE: Total de registros en &tabla_origen: &total_registros;
%put NOTE: Cantidad de chunks a crear: &num_chunks;
%put NOTE: Registros por chunk (aprox.): &registros_por_chunk;

/* 3. Lógica de Creación de los Data Chunks (Splits) - MÉTODO SEGURO */

%do i=1 %to &num_chunks;

/* Cálculo de los puntos de inicio y fin del bloque de registros a leer */
/* ICIO: Registros por chunk * (Índice actual - 1) + 1 */
%let inicio = %sysevalf((&registros_por_chunk * (&i - 1)) + 1);

/* FIN: Registros por chunk * Índice actual */
%let fin = %sysevalf(&registros_por_chunk * &i);

/* Si es el último chunk, asegúrate de que el final no exceda el total */

%if &fin > &total_registros %then
%do;
%let fin = &total_registros;
%end;
%put NOTE: Creando chunk &i: Leyendo de registro &inicio a &fin;

/* Creación del CHUNK con FIRSTOBS y OBS (lectura de bloque exacto) */
data work.&prefix.&i (compress=binary);
/* FIRSTOBS=&inicio comienza a leer desde ese registro. */
/* OBS=&fin indica que deje de leer en ese registro. */
set &tabla_origen (firstobs=&inicio obs=&fin);
run;

%end;

/* Lógica de metadatos (Resto del código es igual) */
proc contents data=work._all_ noprint out=contents;
run;

proc sort data=contents out=members nodupkey;
by memname;
run;

proc sql noprint;
select memname into: tablas separated by "|" from members where 
upcase(memname) like upcase("&prefix.%") order by memname asc;
quit;

%let spltables=&tablas;
%put NOTE: Proceso de split completado. Tablas creadas: work.&prefix.1 hasta work.&prefix.&num_chunks;
%mend split3;

%macro split2(libreria, tabla_origen, wobs, prefix);
options nosyntaxcheck nosymbolgen nosource nosource2 nomlogic nomprint nonotes;
%showMessage(msg=Creando datachunks);
%global splits t cmdintlz spltables tunion tablas wtbltmp cmdintlz workpath;
libname liborg "&libreria.";
%let tbltmp=&prefix.;
%let numobs=0;
%let wtbltmp=&tbltmp;
%let dsid = %sysfunc(open(liborg.&tabla_origen.));

/* abre la tabla */

%if (&dsid ne 0) %then
%do;
%let numobs = %sysfunc(attrn(&dsid, NLOBS));

/* numero de registros del dataset */
%let dsid = %sysfunc(close(&dsid));

/* id de cierre de tabla  */ 
%end;

/* Si la tabla no tiene observaciones no se realizan los splits */

%if (&numobs eq 0) %then
%do;
%put ERROR%str(:) LA TABLA &tabla_origen. NO TIENE REGISTROS%nrstr(,) POR FAVOR VALIDAR;
%abort cancel;
%end;
%let num_splits=%sysevalf(&numobs/&wobs, ceil);
%let numObsPerSession=&wobs;
signoff _all_;
options sascmd="!sascmd";
%let firstobs = 1;
%let obs=&numObsPerSession;

%do i=1 %to &num_splits;

/* 1. se da nombre a la sesion */
signon sessio&i;

/* 2. variables de la sesion */
%syslput sessio=&i / remote = sessio&i;
%syslput firstobs=%str(firstobs = &firstobs) / remote = sessio&i;
%syslput tbltmp=&tbltmp / remote = sessio&i;
%syslput tabla_origen=&tabla_origen / remote = sessio&i;

%if (&i eq &num_splits) %then
%syslput obs = %str() / remote = sessio&i;
%else
%syslput obs = %str(obs=&obs) / remote = sessio&i;

/* 3. Inicia la ejecucion de la sesion */
rsubmit sessio&i wait=no                  /*Inicio rsubmit */
inheritlib = (liborg=wliborg work=pwork);

/* almacena las tablas temporales en work */
options validvarname=any;

data pwork.&tbltmp.&sessio.(compress=binary);
set wliborg.&tabla_origen. (&firstobs &obs);
run;

endrsubmit;

/* Fin rsubmit */

%let firstobs = %eval(&firstobs + &numObsPerSession);
%let obs = %eval(&obs + &numObsPerSession);
%end;

/* Se espera la finalizacion de todas las sesiones */
waitfor _all_ 
%do i=1 %to &num_splits;
sessio&i
 %end;
;
signoff _all_;
%let workpath=%sysfunc(cat(%sysfunc(pathname(work)), /));

/* Lista las tablas del work */
proc contents data=work._all_ noprint out=contents;
run;

proc sort data=contents out=members nodupkey;
by memname;
run;

