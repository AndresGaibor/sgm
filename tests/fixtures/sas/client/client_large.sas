/* Etiqueta: Cruce de firmas */
proc sql;
connect to IMPALA (DSN = IMPALAP);
create table WORK.FA_CTE as
select * from connection to IMPALA
(     
WITH 
TABLA1 AS (
    
    SELECT 
    B.FRMNUMPROD AS NRO_CTA,
    B.FRMNIT AS NRO_DOC,
    MAX((B.FRMANOMOD*10000 + B.FRMMESMOD*100 + B.FRMDIAMOD)*1) as FEC_MOD
    
    from proceso_vspc_finanzas.reemplazo_nid_ext_cte AS A
  
    INNER JOIN S_CANALES.SAI_SCILIBRAMD_SCIFFIMGFR AS B ON A.NRO_CTA=B.FRMNUMPROD

    where  A.RELACION=9902 AND B.FRMNIT <> 0
    GROUP BY B.FRMNUMPROD, B.FRMNIT
    ORDER BY B.FRMNUMPROD, B.FRMNIT 
    
),

TABLA2 AS (

    SELECT
    B.FRMNUMPROD AS NRO_CTA,
    B.FRMNIT AS NRO_DOC,
    B.FRMANOVIG,
    B.FRMMESVIG,
    
    MAX((B.FRMANOMOD*10000 + B.FRMMESMOD*100 + B.FRMDIAMOD)*1) as FEC_MOD
    
    from proceso_vspc_finanzas.reemplazo_nid_ext_cte AS A
  
    INNER JOIN S_CANALES.SAI_SCILIBRAMD_SCIFFIMGFR AS B ON A.NRO_CTA=B.FRMNUMPROD

    where  A.RELACION=9902 AND B.FRMNIT <> 0
    GROUP BY B.FRMNUMPROD, B.FRMNIT, B.FRMANOVIG, B.FRMMESVIG
    ORDER BY B.FRMNUMPROD, B.FRMNIT, B.FRMANOVIG, B.FRMMESVIG
   
)

    select 
 
    T1.NRO_CTA, 
    T1.NRO_DOC,
    MAX(T2.FRMANOVIG*100 + T2.FRMMESVIG) AS FEC_VIG
    
    FROM 
    TABLA1 AS T1
    
    INNER JOIN TABLA2 AS T2 ON (T1.NRO_CTA=T2.NRO_CTA AND T1.NRO_DOC=T2.NRO_DOC AND T1.FEC_MOD=T2.FEC_MOD)
    
    GROUP BY T1.NRO_CTA, T1.NRO_DOC
    ORDER BY T1.NRO_CTA, T1.NRO_DOC;
);
disconnect from IMPALA;  
quit;


