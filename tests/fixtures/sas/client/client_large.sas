        (
                 t1.TIPO_DOC = 0
                 ) 
        THEN 
        48
        /*-----------------------------------------*/
        ELSE 
        t1.TIPO_DOC 
     END 
     AS 
     TIPO_DOC, 
     /****************************************************/
                  /* NRO_DOC */
            CASE 
             /*-----------------------------------------*/
             WHEN 
             (CATS(t1.NRO_DOC)) LIKE '600000%'
             AND 
           LENGTH(CATS(t1.NRO_DOC)) = 10
             AND
                 (
                 t1.TIPO_DOC = 0
               )
             THEN 
