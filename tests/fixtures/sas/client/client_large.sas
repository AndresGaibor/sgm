/* Etiqueta: Reg ubicacion invalida */
PROC SQL;
   CREATE TABLE WORK.INCONS_UBICACION_INVALIDA_CTE AS 
   SELECT DISTINCT t1.LLAVE_NOMBRE, 
          t1.RELACION, 
          t1.TIPO_DOC, 
          t1.NRO_DOC, 
          t1.DV, 
          t1.APELLIDO1, 
          t1.APELLIDO2, 
          t1.NOMBRE1, 
          t1.NOMBRE2, 
          t1.RAZON_SOCIAL, 
          t1.DIRECCION, 
          t1.DEPARTAMENTO, 
          t1.MUNICIPIO, 
          t1.PAIS, 
          t1.NRO_CTA, 
          t1.TIPO_CTA, 
          t1.GMF, 
          t1.FIN_SALDO_CTA, 
          t1.PROM_SALDO_CTA, 
          t1.MED_SALDO_CTA, 
          t1.MAX_SALDO_CTA, 
          t1.MIN_SALDO_CTA, 
          t1.VAL_CRED_MES, 
          t1.NRO_CRED_MES, 
          t1.PROM_CRED_MES, 
          t1.MED_CRED_MES, 
          t1.VAL_DEB_MES, 
          t1.NRO_DEB_MES, 
          t1.PROM_DEB_MES, 
          /* INCONSISTENCIA */
            ('CAMPOS DE UBICACION INCORRECTOS') LABEL="INCONSISTENCIA" AS INCONSISTENCIA
      FROM WORK.SABANA_CORR_NOM_CTE t1
           LEFT JOIN WORK.IMPORT_CODIGOS_DANE t2 ON (t1.CODIGO_UBICACION = t2.CODIGO_DANE)
           LEFT JOIN WORK.IMPORT_CODIGOS_PAIS t3 ON (t1.PAIS = t3.'Codigo_Pais'n)
      WHERE ( t2.CODIGO_DANE IS MISSING AND t1.PAIS = '169' ) OR ( t1.CODIGO_UBICACION NOT IS MISSING AND t1.PAIS NOT = 
           '169' AND t3.'Codigo_Pais'n NOT IS MISSING ) OR t3.'Codigo_Pais'n IS MISSING OR LENGTH(t1.DIRECCION) < 8 OR 
           UPPER(t1.DIRECCION) CONTAINS UPPER('recla') OR UPPER(t1.DIRECCION) CONTAINS UPPER('info') OR 
           UPPER(t1.DIRECCION) CONTAINS UPPER('sin dir') OR t1.DIRECCION = '';
QUIT;

/* Etiqueta: Corregir datos ubicación */
proc sql;

connect to IMPALA (DSN = IMPALAP);
create table WORK.SABANA_CORREGIR_UBICACION_CTE as
select * from connection to IMPALA
(   
SELECT DISTINCT 
          t1.LLAVE_NOMBRE, 
          t1.RELACION, 
          t1.TIPO_DOC, 
          t1.NRO_DOC, 
          t1.DV,  
          t1.APELLIDO1, 
          t1.APELLIDO2,
          CAST(t1.NOMBRE1 AS VARCHAR(200)) AS NOMBRE1, 
          CAST(t1.NOMBRE2 AS VARCHAR(200)) AS NOMBRE2, 
          CAST(t1.RAZON_SOCIAL AS VARCHAR(200)) AS RAZON_SOCIAL, 
            (CASE
            WHEN(
            ((t2.CODIGO_DANE IS NULL) AND (t1.PAIS='169'))
            OR (t3.CODIGO_PAIS IS NULL)
            OR (LENGTH(t1.DIRECCION) < 8 AND LENGTH(t1.DIRECCION) > 0)
            OR (UPPER(t1.DIRECCION) LIKE ('recla'))
            OR (UPPER(t1.DIRECCION) LIKE ('info'))
            OR (UPPER(t1.DIRECCION) LIKE ('sin dir'))
            OR ((t1.DIRECCION IS NULL) AND (t1.PAIS = '169'))
            )
            THEN 'Cra 48 26 85 Av Industriales'
            ELSE t1.DIRECCION
            END) as DIRECCION, 
          /* DEPARTAMENTO */
            (CASE
            WHEN (
            ((t2.CODIGO_DANE IS NULL) AND (t1.PAIS='169')) 
            OR (t3.CODIGO_PAIS IS NULL)
            OR (LENGTH(t1.DIRECCION) < 8 AND LENGTH(t1.DIRECCION) > 0)
            OR (UPPER(t1.DIRECCION) LIKE ('recla'))
            OR (UPPER(t1.DIRECCION) LIKE ('sin info'))
            OR (UPPER(t1.DIRECCION) LIKE ('sin dir'))
            OR ((t1.DIRECCION IS NULL) AND (t1.PAIS = '169'))
            )
            THEN '05'
            ELSE 
                (
                  CASE
                  WHEN ((t1.CODIGO_UBICACION IS NOT NULL) AND (t1.PAIS<>'169') AND (t3.CODIGO_PAIS IS NOT 
            NULL) )
                  THEN ''
                  ELSE t1.DEPARTAMENTO
                  END
                )
            END) AS DEPARTAMENTO, 
          /* MUNICIPIO */
            (CASE
            WHEN (
            ((t2.CODIGO_DANE IS NULL) AND (t1.PAIS='169')) 
            OR (t3.CODIGO_PAIS IS NULL)
            OR (LENGTH(t1.DIRECCION) < 8 AND LENGTH(t1.DIRECCION) > 0)
            OR (UPPER(t1.DIRECCION) LIKE ('recla'))
            OR (UPPER(t1.DIRECCION) LIKE ('sin info'))
            OR (UPPER(t1.DIRECCION) LIKE ('sin dir'))
            OR ((t1.DIRECCION IS NULL) AND (t1.PAIS = '169'))
            )
            THEN '001'
            ELSE 
                (
                  CASE
                  WHEN ((t1.CODIGO_UBICACION IS NOT NULL) AND (t1.PAIS<>'169') AND (t3.CODIGO_PAIS IS NOT 
            NULL) )
                  THEN ''
                  ELSE t1.MUNICIPIO
                  END
                )
            END) AS MUNICIPIO, 
          /* PAIS */
            (CASE
            WHEN (
            (t3.CODIGO_PAIS IS NULL)
            OR (LENGTH(t1.DIRECCION) < 8 AND LENGTH(t1.DIRECCION) > 0)
            OR (UPPER(t1.DIRECCION) LIKE ('recla'))
            OR (UPPER(t1.DIRECCION) LIKE ('sin info'))
            OR (UPPER(t1.DIRECCION)  LIKE ('sin dir'))
            )
            THEN '169'
            ELSE t1.PAIS
            END) AS PAIS, 
          t1.NRO_CTA, 
          t1.TIPO_CTA, 
          t1.GMF, 
          t1.FIN_SALDO_CTA, 
          t1.PROM_SALDO_CTA, 
          t1.MED_SALDO_CTA, 
          t1.MAX_SALDO_CTA, 
          t1.MIN_SALDO_CTA, 
          t1.VAL_CRED_MES, 
          t1.NRO_CRED_MES, 
          t1.PROM_CRED_MES, 
          t1.MED_CRED_MES, 
          t1.VAL_DEB_MES, 
          t1.NRO_DEB_MES, 
          t1.PROM_DEB_MES
      FROM proceso_vspc_finanzas.SABANA_CORR_NOM_CTE t1
           LEFT JOIN proceso_vspc_finanzas.FORMATO_CODIGO_DANE t2 ON (t1.CODIGO_UBICACION = t2.CODIGO_DANE)
           LEFT JOIN proceso_vspc_finanzas.FORMATO_CODIGO_PAIS t3 ON (t1.PAIS = t3.CODIGO_PAIS)
      ORDER BY t1.NRO_CTA,
               t1.RELACION
;
);
disconnect from IMPALA;  
quit;


