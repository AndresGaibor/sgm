            OR (UPPER(t1.DIRECCION) CONTAINS UPPER('sin dir'))
            OR ((t1.DIRECCION IS MISSING) AND (t1.PAIS = '169'))
            )
            THEN '05'
            ELSE 
                (
                  CASE
                  WHEN ((t1.CODIGO_UBICACION NOT IS MISSING) AND (t1.PAIS^='169') AND (t3.'Codigo_Pais'n NOT IS 
            MISSING) )
