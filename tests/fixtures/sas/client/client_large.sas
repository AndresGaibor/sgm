%macro split2(libreria, tabla_origen, wobs, prefix);
%global splits t cmdintlz spltables tunion tablas wtbltmp cmdintlz workpath;
libname liborg "&libreria.";
%let tbltmp=&prefix.;
%let numobs=0;
