/* id de cierre de tabla  */ 
%end;

/* Si la tabla no tiene observaciones no se realizan los splits */

%if (&numobs eq 0) %then
%return;
%let num_splits=%sysevalf(&numobs/&wobs, ceil);
%let numObsPerSession=&wobs;
signoff _all_;
options sascmd="!sascmd";
%let firstobs = 1;
%let obs=&numObsPerSession;

%do i=1 %to &num_splits;

