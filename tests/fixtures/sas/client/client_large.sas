             /*-----------------------------------------*/
             WHEN 
             (CATS(t1.NRO_DOC)) LIKE '60000%'
             AND 
           LENGTH(CATS(t1.NRO_DOC)) = 10
               AND
                 (
                 t1.TIPO_DOC = 0
               )
             THEN 
             SUBSTR((CATS(t1.NRO_DOC)),6)
             /*-----------------------------------------*/ 
             WHEN 
