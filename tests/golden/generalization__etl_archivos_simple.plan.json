    {
      "id": "op00022",
      "kind": "map",
      "status": "parcial",
      "placement": "flow",
      "signature": "4527bcb498cbba5f",
      "params": {
        "steps": [
          {
            "kind": "filter",
            "params": {
              "expression": "cantidad > 0 and not missing(precio)"
            }
          },
          {
            "kind": "derive",
            "params": {
              "assignments": [
                {
                  "target": "prefijo",
                  "expression": "substr(producto, 1, 3)"
                },
                {
                  "target": "importe",
                  "expression": "round(cantidad * precio, 0.01)"
                }
              ]
            }
          },
          {
            "kind": "derive",
            "params": {
              "conditional": "if canal = 'WEB' then descuento = 0.05"
            }
          },
          {
            "kind": "derive",
            "params": {
              "conditional": "else if canal = 'TIENDA' then descuento = 0.02"
            }
          },
          {
            "kind": "filter",
            "params": {
              "expression": "else descuento = 0"
            }
          },
          {
            "kind": "derive",
            "params": {
              "assignments": [
                {
                  "target": "importe_neto",
                  "expression": "importe * (1 - descuento)"
                }
              ]
            }
          },
          {
            "kind": "rename",
            "params": {
              "pairs": [
                [
                  "cliente",
                  "cod_cliente"
                ],
                [
                  "producto",
                  "cod_producto"
                ]
              ],
              "outputs": [
                "WORK.pedidos_ok"
              ]
            }
          }
        ],
