/* Caso L8-04: totales de origen y de salida por producto (CTE y AHO).                    */
/* Rebanada de "Total cuentas" y "Suma Saldo final" de client_large.sas.                   */
/* Datos ficticios (SIM...). Saldos con espacios a la izquierda y algunos vacíos.           */
/* Supuesto del caso (no del SAS): la salida excluye TIPO_CTA 03.                          */

/* Etiqueta: Importar origen CTE */
proc import datafile='/work_sasstudio/pcfiles/origen_cte.csv' out=WORK.IMPORT_ORIGEN_CTE
dbms=dlm replace;
delimiter=';';
getnames=NO;
run;

/* Etiqueta: Importar origen AHO */
proc import datafile='/work_sasstudio/pcfiles/origen_aho.csv' out=WORK.IMPORT_ORIGEN_AHO
dbms=dlm replace;
delimiter=';';
getnames=NO;
run;

/* Etiqueta: Nombres de columnas CTE */
PROC SQL;
CREATE TABLE WORK.ORIGEN_CTE AS
SELECT VAR1 AS ANIO_PROCESO, VAR2 AS MES_PROCESO, VAR3 AS CODIGO_OFICINA,
       VAR4 AS RELACION, VAR5 AS CODIGO_SUCURSAL, VAR6 AS TIPO_CTA,
       VAR7 AS NRO_CTA, VAR8 AS LLAVE_NOMBRE, VAR9 AS TIPO_DOC,
       VAR10 AS NRO_DOC, VAR11 AS GMF, VAR12 AS VAL_CRED_MES,
       VAR13 AS NRO_CRED_MES, VAR14 AS PROM_CRED_MES, VAR15 AS MED_CRED_MES,
       VAR16 AS VAL_DEB_MES, VAR17 AS NRO_DEB_MES, VAR18 AS PROM_DEB_MES,
       VAR19 AS MED_SALDO_CTA, VAR20 AS PROM_SALDO_CTA, VAR21 AS MAX_SALDO_CTA,
       VAR22 AS MIN_SALDO_CTA, VAR23 AS FIN_SALDO_CTA
FROM WORK.IMPORT_ORIGEN_CTE;
QUIT;

/* Etiqueta: Nombres de columnas AHO */
PROC SQL;
CREATE TABLE WORK.ORIGEN_AHO AS
SELECT VAR1 AS ANIO_PROCESO, VAR2 AS MES_PROCESO, VAR3 AS CODIGO_OFICINA,
       VAR4 AS RELACION, VAR5 AS CODIGO_SUCURSAL, VAR6 AS TIPO_CTA,
       VAR7 AS NRO_CTA, VAR8 AS LLAVE_NOMBRE, VAR9 AS TIPO_DOC,
       VAR10 AS NRO_DOC, VAR11 AS GMF, VAR12 AS VAL_CRED_MES,
       VAR13 AS NRO_CRED_MES, VAR14 AS PROM_CRED_MES, VAR15 AS MED_CRED_MES,
       VAR16 AS VAL_DEB_MES, VAR17 AS NRO_DEB_MES, VAR18 AS PROM_DEB_MES,
       VAR19 AS MED_SALDO_CTA, VAR20 AS PROM_SALDO_CTA, VAR21 AS MAX_SALDO_CTA,
       VAR22 AS MIN_SALDO_CTA, VAR23 AS FIN_SALDO_CTA
FROM WORK.IMPORT_ORIGEN_AHO;
QUIT;

/* Etiqueta: Saldo numérico CTE */
data WORK.ORIGEN_CTE;
set WORK.ORIGEN_CTE;
FORM_FIN_SALDO_CTA = input(left(FIN_SALDO_CTA), 20.);
run;

/* Etiqueta: Saldo numérico AHO */
data WORK.ORIGEN_AHO;
set WORK.ORIGEN_AHO;
FORM_FIN_SALDO_CTA = input(left(FIN_SALDO_CTA), 20.);
run;

/* Etiqueta: Total cuentas origen CTE */
%web_drop_table(WORK.TOTAL_ORIGEN_CTE);

PROC SQL;
CREATE TABLE WORK.TOTAL_ORIGEN_CTE AS
SELECT COUNT(*) AS NRO_FILAS_ORIGEN,
       COUNT(FORM_FIN_SALDO_CTA) AS NRO_SALDOS_NO_VACIOS,
       SUM(FORM_FIN_SALDO_CTA) AS SUMA_SALDO_ORIGEN
FROM WORK.ORIGEN_CTE;
QUIT;

%web_open_table(WORK.TOTAL_ORIGEN_CTE);

/* Etiqueta: Total cuentas salida CTE */
%web_drop_table(WORK.TOTAL_SALIDA_CTE);

PROC SQL;
CREATE TABLE WORK.TOTAL_SALIDA_CTE AS
SELECT COUNT(*) AS NRO_FILAS_SALIDA,
       SUM(FORM_FIN_SALDO_CTA) AS SUMA_SALDO_SALIDA
FROM WORK.ORIGEN_CTE
WHERE TIPO_CTA <> '03';
QUIT;

%web_open_table(WORK.TOTAL_SALIDA_CTE);

/* Etiqueta: Total cuentas origen AHO */
%web_drop_table(WORK.TOTAL_ORIGEN_AHO);

PROC SQL;
CREATE TABLE WORK.TOTAL_ORIGEN_AHO AS
SELECT COUNT(*) AS NRO_FILAS_ORIGEN,
       COUNT(FORM_FIN_SALDO_CTA) AS NRO_SALDOS_NO_VACIOS,
       SUM(FORM_FIN_SALDO_CTA) AS SUMA_SALDO_ORIGEN
FROM WORK.ORIGEN_AHO;
QUIT;

%web_open_table(WORK.TOTAL_ORIGEN_AHO);

/* Etiqueta: Total cuentas salida AHO */
%web_drop_table(WORK.TOTAL_SALIDA_AHO);

PROC SQL;
CREATE TABLE WORK.TOTAL_SALIDA_AHO AS
SELECT COUNT(*) AS NRO_FILAS_SALIDA,
       SUM(FORM_FIN_SALDO_CTA) AS SUMA_SALDO_SALIDA
FROM WORK.ORIGEN_AHO
WHERE TIPO_CTA <> '03';
QUIT;

%web_open_table(WORK.TOTAL_SALIDA_AHO);

/* Etiqueta: Suma Saldo final CTE, valor escalar */
PROC SQL;
CREATE TABLE WORK.SUMA_SALDO_CTE_ESCALAR AS
SELECT SUM(ORIGEN_CTE.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_FINAL_CTE
FROM WORK.ORIGEN_CTE ORIGEN_CTE;
QUIT;

/* Etiqueta: Suma Saldo final AHO, valor escalar */
PROC SQL;
CREATE TABLE WORK.SUMA_SALDO_AHO_ESCALAR AS
SELECT SUM(ORIGEN_AHO.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_FINAL_AHO
FROM WORK.ORIGEN_AHO ORIGEN_AHO;
QUIT;

/* Etiqueta: Saldo final CTE con formato, como en el original */
data EXP_SUMA_SALDO_CTE;
FORMAT SUMA_SALDO_FINAL_CTE BEST20.;
set SUMA_SALDO_CTE_ESCALAR;
run;

/* Etiqueta: Saldo final AHO con formato, como en el original */
data EXP_SUMA_SALDO_AHO;
FORMAT SUMA_SALDO_FINAL_AHO BEST20.;
set SUMA_SALDO_AHO_ESCALAR;
run;

/* Etiqueta: Comparación de totales por producto */
PROC SQL;
CREATE TABLE WORK.RESUMEN_TOTALES AS
SELECT TOTAL_ORIGEN_CTE.NRO_FILAS_ORIGEN AS FILAS_ORIGEN_CTE,
       TOTAL_SALIDA_CTE.NRO_FILAS_SALIDA AS FILAS_SALIDA_CTE,
       TOTAL_ORIGEN_AHO.NRO_FILAS_ORIGEN AS FILAS_ORIGEN_AHO,
       TOTAL_SALIDA_AHO.NRO_FILAS_SALIDA AS FILAS_SALIDA_AHO
FROM WORK.TOTAL_ORIGEN_CTE TOTAL_ORIGEN_CTE,
     WORK.TOTAL_SALIDA_CTE TOTAL_SALIDA_CTE,
     WORK.TOTAL_ORIGEN_AHO TOTAL_ORIGEN_AHO,
     WORK.TOTAL_SALIDA_AHO TOTAL_SALIDA_AHO;
QUIT;

%web_open_table(WORK.RESUMEN_TOTALES);

/* Etiqueta: Limpieza de tablas de escalar */
PROC DELETE DATA=WORK.SUMA_SALDO_CTE_ESCALAR;
RUN;

PROC DELETE DATA=WORK.SUMA_SALDO_AHO_ESCALAR;
RUN;
