/* Caso L8-01: duplicados y frecuencias del producto AHO.                                  */
/* Rebanada de la etapa de duplicados de client_large.sas. Datos ficticios (SIM...).       */
/* Entrada: origen_aho.csv, delimitado con ;, sin cabecera, 23 columnas por posición.      */

/* Etiqueta: Macrovariables */
%let ruta_origen = /work_sasstudio/pcfiles/origen_aho.csv;

/* Etiqueta: Importar origen AHO */
proc import datafile='/work_sasstudio/pcfiles/origen_aho.csv' out=WORK.IMPORT_ORIGEN_AHO
dbms=dlm replace;
delimiter=';';
getnames=NO;
run;

/* Etiqueta: Nombres de columnas AHO */
PROC SQL;
CREATE TABLE WORK.ORIGEN_AHO AS
SELECT VAR1 AS ANIO_PROCESO, VAR2 AS MES_PROCESO, VAR3 AS CODIGO_OFICINA,
       VAR4 AS RELACION, VAR5 AS CODIGO_SUCURSAL, VAR6 AS TIPO_CTA,
       VAR7 AS NRO_CTA, VAR8 AS LLAVE_NOMBRE, VAR9 AS TIPO_DOC,
       VAR10 AS NRO_DOC, VAR11 AS GMF, VAR12 AS VAL_CRED_MES,
       VAR13 AS NRO_CRED_MES, VAR14 AS PROM_CRED_MES, VAR15 AS MED_CRED_MES,
       VAR16 AS VAL_DEB_MES, VAR17 AS NRO_DEB_MES, VAR18 AS PROM_DEB_MES,
       VAR19 AS MED_SALDO_CTA, VAR20 AS PROM_SALDO_CTA, VAR21 AS MAX_SALDO_CTA,
       VAR22 AS MIN_SALDO_CTA, VAR23 AS FIN_SALDO_CTA
FROM WORK.IMPORT_ORIGEN_AHO;
QUIT;

/* Etiqueta: Saldo numérico AHO */
data WORK.ORIGEN_AHO;
set WORK.ORIGEN_AHO;
FORM_FIN_SALDO_CTA = input(left(FIN_SALDO_CTA), 20.);
run;

/* Etiqueta: Conteo de origen AHO */
%web_drop_table(WORK.CUENTA_ORIGEN_AHO);

PROC SQL;
CREATE TABLE WORK.CUENTA_ORIGEN_AHO AS
SELECT COUNT(*) AS NRO_REGISTROS_ORIGEN
FROM WORK.ORIGEN_AHO;
QUIT;

/* Etiqueta: Frecuencia de Registros */
PROC SQL;
CREATE TABLE WORK.FRECUENCIA_REGISTROS_AHO AS
SELECT COUNT(*) AS FRECUENCIA,
       RELACION,
       TIPO_CTA,
       NRO_CTA,
       TIPO_DOC,
       NRO_DOC
FROM WORK.ORIGEN_AHO
GROUP BY RELACION, TIPO_CTA, NRO_CTA, TIPO_DOC, NRO_DOC
HAVING COUNT(*) > 1;
QUIT;

/* Etiqueta: Cuenta frecuencia */
PROC SQL;
CREATE TABLE WORK.CONCILIACION_DUPLICADOS_AHO AS
SELECT FRECUENCIA,
       CASE
           WHEN FRECUENCIA > 2 THEN FRECUENCIA - 2
           ELSE 0
       END AS CUENTA
FROM WORK.FRECUENCIA_REGISTROS_AHO;
QUIT;

/* Etiqueta: Firmas autorizadas duplicadas */
%web_drop_table(WORK.FILTRO_DUPLICADOS_AHO);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.FILTRO_DUPLICADOS_AHO
AS
SELECT FRECUENCIA_REGISTROS_AHO.RELACION, FRECUENCIA_REGISTROS_AHO.TIPO_CTA,
       FRECUENCIA_REGISTROS_AHO.NRO_CTA, FRECUENCIA_REGISTROS_AHO.TIPO_DOC,
       FRECUENCIA_REGISTROS_AHO.NRO_DOC, FRECUENCIA_REGISTROS_AHO.FRECUENCIA
FROM WORK.FRECUENCIA_REGISTROS_AHO FRECUENCIA_REGISTROS_AHO
WHERE
   ( FRECUENCIA_REGISTROS_AHO.FRECUENCIA > 1 );
QUIT;

%web_open_table(WORK.FILTRO_DUPLICADOS_AHO);

/* Etiqueta: Suma duplicados */
PROC SQL;
CREATE TABLE WORK.CUENTA_CONC_DUPLICADOS_AHO AS
SELECT SUM(CONCILIACION_DUPLICADOS_AHO.CUENTA) AS NRO_REGISTROS_DUPLICADOS
FROM WORK.CONCILIACION_DUPLICADOS_AHO CONCILIACION_DUPLICADOS_AHO;
QUIT;

%web_open_table(WORK.CUENTA_CONC_DUPLICADOS_AHO);

/* Etiqueta: Duplicados exactos AHO (NODUPREC) */
PROC SORT DATA=WORK.ORIGEN_AHO OUT=WORK.AHO_SIN_DUPLICADOS_EXACTOS NODUPREC;
BY _ALL_;
RUN;

/* Etiqueta: Llaves AHO ordenadas */
PROC SORT DATA=WORK.ORIGEN_AHO OUT=WORK.AHO_ORDENADO;
BY RELACION TIPO_CTA NRO_CTA TIPO_DOC NRO_DOC;
RUN;

/* Etiqueta: Una fila por llave AHO (NODUPKEY) */
PROC SORT DATA=WORK.AHO_ORDENADO OUT=WORK.AHO_UNICOS NODUPKEY;
BY RELACION TIPO_CTA NRO_CTA TIPO_DOC NRO_DOC;
RUN;

/* Etiqueta: Conteo de filas sin duplicados exactos */
PROC SQL;
CREATE TABLE WORK.CUENTA_SIN_EXACTOS_AHO AS
SELECT COUNT(*) AS NRO_REGISTROS_SIN_EXACTOS
FROM WORK.AHO_SIN_DUPLICADOS_EXACTOS;
QUIT;

/* Etiqueta: Conteo de llaves únicas AHO */
PROC SQL;
CREATE TABLE WORK.CUENTA_LLAVES_AHO AS
SELECT COUNT(*) AS NRO_LLAVES_UNICAS
FROM WORK.AHO_UNICOS;
QUIT;

/* Etiqueta: Suma saldo origen AHO */
PROC SQL;
CREATE TABLE WORK.SUMA_SALDO_ORIGEN_AHO AS
SELECT SUM(ORIGEN_AHO.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_ORIGEN
FROM WORK.ORIGEN_AHO ORIGEN_AHO;
QUIT;

/* Etiqueta: Totales de control AHO */
PROC SQL;
CREATE TABLE WORK.CONTROL_DUPLICADOS_AHO AS
SELECT CUENTA_ORIGEN_AHO.NRO_REGISTROS_ORIGEN,
       CUENTA_SIN_EXACTOS_AHO.NRO_REGISTROS_SIN_EXACTOS,
       CUENTA_LLAVES_AHO.NRO_LLAVES_UNICAS,
       CUENTA_CONC_DUPLICADOS_AHO.NRO_REGISTROS_DUPLICADOS
FROM WORK.CUENTA_ORIGEN_AHO CUENTA_ORIGEN_AHO,
     WORK.CUENTA_SIN_EXACTOS_AHO CUENTA_SIN_EXACTOS_AHO,
     WORK.CUENTA_LLAVES_AHO CUENTA_LLAVES_AHO,
     WORK.CUENTA_CONC_DUPLICADOS_AHO CUENTA_CONC_DUPLICADOS_AHO;
QUIT;

%web_open_table(WORK.CONTROL_DUPLICADOS_AHO);

/* Etiqueta: Llaves con más de una fila (vista de revisión) */
PROC SQL;
CREATE TABLE WORK.REVISION_LLAVES_AHO AS
SELECT RELACION, TIPO_CTA, NRO_CTA, TIPO_DOC, NRO_DOC, COUNT(*) AS VECES
FROM WORK.ORIGEN_AHO
GROUP BY RELACION, TIPO_CTA, NRO_CTA, TIPO_DOC, NRO_DOC
HAVING VECES > 1
ORDER BY NRO_CTA;
QUIT;

/* Etiqueta: Llaves repetidas por tipo de cuenta */
PROC SQL;
CREATE TABLE WORK.REPETIDAS_POR_TIPO_AHO AS
SELECT TIPO_CTA, COUNT(*) AS NRO_LLAVES_REPETIDAS
FROM WORK.REVISION_LLAVES_AHO
GROUP BY TIPO_CTA;
QUIT;

/* Etiqueta: Limpieza de tablas auxiliares */
PROC DELETE DATA=WORK.AHO_ORDENADO;
RUN;
