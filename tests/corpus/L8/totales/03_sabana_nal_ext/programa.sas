/* Caso L8-03: sábana final nacional y extranjera del producto AHO.                        */
/* Rebanada de "Sabana final" / "Organizar campos" de client_large.sas, con la salida en CSV. */
/* Datos ficticios (SIM...). Entrada: origen_aho.csv, 23 columnas, sin cabecera, con ;.     */
/* Supuesto del caso (no del SAS): extranjero = TIPO_DOC PA o CE.                           */

/* Etiqueta: Importar origen AHO */
proc import datafile='/work_sasstudio/pcfiles/origen_aho.csv' out=WORK.IMPORT_ORIGEN_AHO
dbms=dlm replace;
delimiter=';';
getnames=NO;
run;

/* Etiqueta: Nombres de columnas AHO */
PROC SQL;
CREATE TABLE WORK.ORIGEN_AHO AS
SELECT VAR1 AS ANIO_PROCESO, VAR2 AS MES_PROCESO, VAR3 AS CODIGO_OFICINA,
       VAR4 AS RELACION, VAR5 AS CODIGO_SUCURSAL, VAR6 AS TIPO_CTA,
       VAR7 AS NRO_CTA, VAR8 AS LLAVE_NOMBRE, VAR9 AS TIPO_DOC,
       VAR10 AS NRO_DOC, VAR11 AS GMF, VAR12 AS VAL_CRED_MES,
       VAR13 AS NRO_CRED_MES, VAR14 AS PROM_CRED_MES, VAR15 AS MED_CRED_MES,
       VAR16 AS VAL_DEB_MES, VAR17 AS NRO_DEB_MES, VAR18 AS PROM_DEB_MES,
       VAR19 AS MED_SALDO_CTA, VAR20 AS PROM_SALDO_CTA, VAR21 AS MAX_SALDO_CTA,
       VAR22 AS MIN_SALDO_CTA, VAR23 AS FIN_SALDO_CTA
FROM WORK.IMPORT_ORIGEN_AHO;
QUIT;

/* Etiqueta: Saldo numérico AHO */
data WORK.ORIGEN_AHO;
set WORK.ORIGEN_AHO;
FORM_FIN_SALDO_CTA = input(left(FIN_SALDO_CTA), 20.);
run;

/* Etiqueta: Organizar campos AHO */
%web_drop_table(WORK.COLUMNAS_AHO);

PROC SQL;
CREATE TABLE WORK.COLUMNAS_AHO
AS
SELECT ORIGEN_AHO.RELACION, ORIGEN_AHO.TIPO_CTA, ORIGEN_AHO.NRO_CTA,
       ORIGEN_AHO.LLAVE_NOMBRE, ORIGEN_AHO.TIPO_DOC, ORIGEN_AHO.NRO_DOC,
       ORIGEN_AHO.GMF, ORIGEN_AHO.VAL_CRED_MES, ORIGEN_AHO.NRO_CRED_MES,
       ORIGEN_AHO.PROM_CRED_MES, ORIGEN_AHO.MED_CRED_MES, ORIGEN_AHO.VAL_DEB_MES,
       ORIGEN_AHO.NRO_DEB_MES, ORIGEN_AHO.PROM_DEB_MES, ORIGEN_AHO.MED_SALDO_CTA,
       ORIGEN_AHO.PROM_SALDO_CTA, ORIGEN_AHO.MAX_SALDO_CTA, ORIGEN_AHO.MIN_SALDO_CTA,
       ORIGEN_AHO.FORM_FIN_SALDO_CTA
FROM WORK.ORIGEN_AHO ORIGEN_AHO;
QUIT;

%web_open_table(WORK.COLUMNAS_AHO);

/* Etiqueta: Sin cuenta AHO */
PROC SQL;
CREATE TABLE WORK.SABANA_VALIDA_AHO AS
SELECT *
FROM WORK.COLUMNAS_AHO
WHERE NRO_CTA IS NOT MISSING AND NRO_CTA <> '';
QUIT;

/* Etiqueta: Sin cuenta AHO, conteo */
PROC SQL;
CREATE TABLE WORK.CUENTA_SIN_CTA_AHO AS
SELECT COUNT(*) AS NRO_FILAS_SIN_CUENTA
FROM WORK.COLUMNAS_AHO
WHERE NRO_CTA = '';
QUIT;

/* Etiqueta: Clasificación nacional o extranjera AHO */
data WORK.SABANA_CLASIF_AHO;
set WORK.SABANA_VALIDA_AHO;
length ORIGEN_PAIS $ 3;
if TIPO_DOC in ('PA', 'CE') then ORIGEN_PAIS = 'EXT';
else ORIGEN_PAIS = 'NAL';
run;

/* Etiqueta: Sabana nacional AHO */
%web_drop_table(WORK.SABANA_NAL_AHO);

PROC SQL;
CREATE TABLE WORK.SABANA_NAL_AHO AS
SELECT RELACION, TIPO_CTA, NRO_CTA, LLAVE_NOMBRE, TIPO_DOC, NRO_DOC, GMF,
       VAL_CRED_MES, NRO_CRED_MES, PROM_CRED_MES, MED_CRED_MES, VAL_DEB_MES,
       NRO_DEB_MES, PROM_DEB_MES, MED_SALDO_CTA, PROM_SALDO_CTA, MAX_SALDO_CTA,
       MIN_SALDO_CTA, FORM_FIN_SALDO_CTA
FROM WORK.SABANA_CLASIF_AHO
WHERE ORIGEN_PAIS = 'NAL'
ORDER BY NRO_CTA;
QUIT;

%web_open_table(WORK.SABANA_NAL_AHO);

/* Etiqueta: Sabana extranjera AHO */
%web_drop_table(WORK.SABANA_EXT_AHO);

PROC SQL;
CREATE TABLE WORK.SABANA_EXT_AHO AS
SELECT RELACION, TIPO_CTA, NRO_CTA, LLAVE_NOMBRE, TIPO_DOC, NRO_DOC, GMF,
       VAL_CRED_MES, NRO_CRED_MES, PROM_CRED_MES, MED_CRED_MES, VAL_DEB_MES,
       NRO_DEB_MES, PROM_DEB_MES, MED_SALDO_CTA, PROM_SALDO_CTA, MAX_SALDO_CTA,
       MIN_SALDO_CTA, FORM_FIN_SALDO_CTA
FROM WORK.SABANA_CLASIF_AHO
WHERE ORIGEN_PAIS = 'EXT'
ORDER BY NRO_CTA;
QUIT;

%web_open_table(WORK.SABANA_EXT_AHO);

/* Etiqueta: Orden registros nacional */
PROC SORT DATA=WORK.SABANA_NAL_AHO;
BY NRO_CTA;
RUN;

/* Etiqueta: Orden registros extranjera */
PROC SORT DATA=WORK.SABANA_EXT_AHO;
BY NRO_CTA;
RUN;

/* Etiqueta: Resultado nacional AHO CSV */
PROC EXPORT DATA=WORK.SABANA_NAL_AHO
   OUTFILE='/work_sasstudio/pcfiles/RESULTADO_AHO_NAL.csv'
   DBMS=CSV REPLACE;
RUN;

/* Etiqueta: Resultado extranjero AHO CSV */
PROC EXPORT DATA=WORK.SABANA_EXT_AHO
   OUTFILE='/work_sasstudio/pcfiles/RESULTADO_AHO_EXT.csv'
   DBMS=CSV REPLACE;
RUN;

/* Etiqueta: Conteo resultado nacional AHO */
PROC SQL;
CREATE TABLE WORK.CUENTA_NAL_AHO AS
SELECT COUNT(*) AS NRO_RESULTADO_NAL
FROM WORK.SABANA_NAL_AHO;
QUIT;

/* Etiqueta: Conteo resultado extranjero AHO */
PROC SQL;
CREATE TABLE WORK.CUENTA_EXT_AHO AS
SELECT COUNT(*) AS NRO_RESULTADO_EXT
FROM WORK.SABANA_EXT_AHO;
QUIT;

/* Etiqueta: Suma saldo nacional AHO */
PROC SQL;
CREATE TABLE WORK.SUMA_NAL_AHO AS
SELECT SUM(SABANA_NAL_AHO.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_NAL
FROM WORK.SABANA_NAL_AHO SABANA_NAL_AHO;
QUIT;

/* Etiqueta: Suma saldo extranjero AHO */
PROC SQL;
CREATE TABLE WORK.SUMA_EXT_AHO AS
SELECT SUM(SABANA_EXT_AHO.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_EXT
FROM WORK.SABANA_EXT_AHO SABANA_EXT_AHO;
QUIT;

/* Etiqueta: Control de sábana AHO */
PROC SQL;
CREATE TABLE WORK.CONTROL_SABANA_AHO AS
SELECT CUENTA_NAL_AHO.NRO_RESULTADO_NAL,
       CUENTA_EXT_AHO.NRO_RESULTADO_EXT,
       CUENTA_SIN_CTA_AHO.NRO_FILAS_SIN_CUENTA
FROM WORK.CUENTA_NAL_AHO CUENTA_NAL_AHO,
     WORK.CUENTA_EXT_AHO CUENTA_EXT_AHO,
     WORK.CUENTA_SIN_CTA_AHO CUENTA_SIN_CTA_AHO;
QUIT;

%web_open_table(WORK.CONTROL_SABANA_AHO);

/* Etiqueta: Limpieza de tablas auxiliares */
PROC DELETE DATA=WORK.SABANA_CLASIF_AHO;
RUN;
