/* Caso L8-02: inconsistencias corregidas y por corregir del producto AHO.                 */
/* Rebanada de las etapas Incons corregidas / Incons por corregir de client_large.sas.     */
/* Datos ficticios (SIM...). Entrada: origen_aho.csv, 23 columnas, sin cabecera, con ;.     */

/* Etiqueta: Importar origen AHO */
proc import datafile='/work_sasstudio/pcfiles/origen_aho.csv' out=WORK.IMPORT_ORIGEN_AHO
dbms=dlm replace;
delimiter=';';
getnames=NO;
run;

/* Etiqueta: Nombres de columnas AHO */
PROC SQL;
CREATE TABLE WORK.ORIGEN_AHO AS
SELECT VAR1 AS ANIO_PROCESO, VAR2 AS MES_PROCESO, VAR3 AS CODIGO_OFICINA,
       VAR4 AS RELACION, VAR5 AS CODIGO_SUCURSAL, VAR6 AS TIPO_CTA,
       VAR7 AS NRO_CTA, VAR8 AS LLAVE_NOMBRE, VAR9 AS TIPO_DOC,
       VAR10 AS NRO_DOC, VAR11 AS GMF, VAR12 AS VAL_CRED_MES,
       VAR13 AS NRO_CRED_MES, VAR14 AS PROM_CRED_MES, VAR15 AS MED_CRED_MES,
       VAR16 AS VAL_DEB_MES, VAR17 AS NRO_DEB_MES, VAR18 AS PROM_DEB_MES,
       VAR19 AS MED_SALDO_CTA, VAR20 AS PROM_SALDO_CTA, VAR21 AS MAX_SALDO_CTA,
       VAR22 AS MIN_SALDO_CTA, VAR23 AS FIN_SALDO_CTA
FROM WORK.IMPORT_ORIGEN_AHO;
QUIT;

/* Etiqueta: Saldo numérico AHO */
data WORK.ORIGEN_AHO;
set WORK.ORIGEN_AHO;
FORM_FIN_SALDO_CTA = input(left(FIN_SALDO_CTA), 20.);
run;

/* Etiqueta: Campo inconsistencia AHO */
/* Por corregir tiene prioridad: una fila con ambas cosas no se corrige, va al archivo. */
data WORK.MARCA_AHO;
set WORK.ORIGEN_AHO;
length INCONSISTENCIA $ 40 CORREGIDA $ 2;
INCONSISTENCIA = '';
CORREGIDA = 'NO';
if TIPO_CTA not in ('01', '02', '03') then INCONSISTENCIA = 'TIPO_CTA_INVALIDO';
else if GMF not in ('S', 'N') then INCONSISTENCIA = 'GMF_INVALIDO';
else if NRO_CTA = '' then INCONSISTENCIA = 'NRO_CTA_VACIO';
if INCONSISTENCIA = '' then do;
   if TIPO_DOC = 'CEDULA' then do;
      TIPO_DOC = 'CC';
      CORREGIDA = 'SI';
   end;
   if NRO_DOC = '' then do;
      NRO_DOC = '0';
      CORREGIDA = 'SI';
   end;
end;
run;

/* Etiqueta: Incons tipo cuenta AHO */
PROC SQL;
CREATE TABLE WORK.INCONS_TIPO_CTA_AHO AS
SELECT * FROM WORK.MARCA_AHO WHERE INCONSISTENCIA = 'TIPO_CTA_INVALIDO';
QUIT;

/* Etiqueta: Incons GMF AHO */
PROC SQL;
CREATE TABLE WORK.INCONS_GMF_AHO AS
SELECT * FROM WORK.MARCA_AHO WHERE INCONSISTENCIA = 'GMF_INVALIDO';
QUIT;

/* Etiqueta: Incons sin cuenta AHO */
PROC SQL;
CREATE TABLE WORK.INCONS_NRO_CTA_VACIO_AHO AS
SELECT * FROM WORK.MARCA_AHO WHERE INCONSISTENCIA = 'NRO_CTA_VACIO';
QUIT;

/* Etiqueta: Incons corregidas AHO */
PROC SQL;
   CREATE TABLE WORK.INCONS_DEP_CORREGIDA_AHO AS
   SELECT *
      FROM WORK.MARCA_AHO
      WHERE CORREGIDA = 'SI';
QUIT;

/* Etiqueta: Incons por corregir AHO */
PROC SQL;
   CREATE TABLE WORK.INCONS_DEP_AHO AS
   SELECT *
      FROM WORK.INCONS_TIPO_CTA_AHO t1
           OUTER UNION CORR
   SELECT *
      FROM WORK.INCONS_GMF_AHO t2
           OUTER UNION CORR
   SELECT *
      FROM WORK.INCONS_NRO_CTA_VACIO_AHO t3;
QUIT;

/* Etiqueta: Sabana final AHO */
%web_drop_table(WORK.SABANA_FINAL_AHO);

PROC SQL;
CREATE TABLE WORK.SABANA_FINAL_AHO
AS
SELECT
DISTINCT MARCA_AHO.RELACION, MARCA_AHO.TIPO_CTA, MARCA_AHO.NRO_CTA,
         MARCA_AHO.TIPO_DOC, MARCA_AHO.NRO_DOC, MARCA_AHO.GMF,
         MARCA_AHO.FORM_FIN_SALDO_CTA, MARCA_AHO.CORREGIDA
FROM WORK.MARCA_AHO MARCA_AHO
LEFT JOIN WORK.INCONS_DEP_AHO INCONS_DEP_AHO
ON
   ( MARCA_AHO.NRO_CTA = INCONS_DEP_AHO.NRO_CTA )
WHERE INCONS_DEP_AHO.NRO_CTA IS MISSING;
QUIT;

%web_open_table(WORK.SABANA_FINAL_AHO);

/* Etiqueta: Nro inconsistencias corregidas */
PROC SQL;
CREATE TABLE WORK.CUENTA_INCONS_CORR_AHO AS
SELECT COUNT(INCONS_DEP_CORREGIDA_AHO.RELACION) AS NRO_REGISTROS_INCONS_CORREGIDOS
FROM WORK.INCONS_DEP_CORREGIDA_AHO INCONS_DEP_CORREGIDA_AHO;
QUIT;

/* Etiqueta: Nro inconsistencias por corregir */
PROC SQL;
CREATE TABLE WORK.CUENTA_INCONS_POR_CORR_AHO AS
SELECT COUNT(INCONS_DEP_AHO.RELACION) AS NRO_INCONS_POR_CORREGIR
FROM WORK.INCONS_DEP_AHO INCONS_DEP_AHO;
QUIT;

/* Etiqueta: Nro registros sabana final AHO */
PROC SQL;
CREATE TABLE WORK.CUENTA_SABANA_AHO AS
SELECT COUNT(*) AS NRO_REG_SABANA_FINAL
FROM WORK.SABANA_FINAL_AHO;
QUIT;

/* Etiqueta: Suma saldo sabana final AHO */
PROC SQL;
CREATE TABLE WORK.SUMA_SABANA_AHO AS
SELECT SUM(SABANA_FINAL_AHO.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_SABANA_FINAL
FROM WORK.SABANA_FINAL_AHO SABANA_FINAL_AHO;
QUIT;

/* Etiqueta: Suma saldo sabana final AHO (corregidas por separado) */
PROC SQL;
CREATE TABLE WORK.SUMA_CORREGIDAS_AHO AS
SELECT SUM(INCONS_DEP_CORREGIDA_AHO.FORM_FIN_SALDO_CTA) AS SUMA_SALDO_CORREGIDAS
FROM WORK.INCONS_DEP_CORREGIDA_AHO INCONS_DEP_CORREGIDA_AHO;
QUIT;

/* Etiqueta: Archivo de inconsistencias por corregir AHO */
PROC EXPORT DATA=WORK.INCONS_DEP_AHO
   OUTFILE='/work_sasstudio/pcfiles/INCONS_DEP_AHO.csv'
   DBMS=CSV REPLACE;
RUN;

/* Etiqueta: Control de inconsistencias AHO */
PROC SQL;
CREATE TABLE WORK.CONTROL_INCONS_AHO AS
SELECT CUENTA_INCONS_CORR_AHO.NRO_REGISTROS_INCONS_CORREGIDOS,
       CUENTA_INCONS_POR_CORR_AHO.NRO_INCONS_POR_CORREGIR,
       CUENTA_SABANA_AHO.NRO_REG_SABANA_FINAL
FROM WORK.CUENTA_INCONS_CORR_AHO CUENTA_INCONS_CORR_AHO,
     WORK.CUENTA_INCONS_POR_CORR_AHO CUENTA_INCONS_POR_CORR_AHO,
     WORK.CUENTA_SABANA_AHO CUENTA_SABANA_AHO;
QUIT;

%web_open_table(WORK.CONTROL_INCONS_AHO);

/* Etiqueta: Limpieza de tablas auxiliares */
PROC DELETE DATA=WORK.INCONS_TIPO_CTA_AHO;
RUN;
