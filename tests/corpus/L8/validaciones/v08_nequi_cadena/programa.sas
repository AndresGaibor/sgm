/* Etiqueta: Macrovariables */
/* Caso ficticio L8 v08. Cadena de validaciones para Nequi, con otra homologacion y sin la etapa
   de tipo de cuenta. En el original la region Nequi tampoco tiene ese paso (etiquetas entre las
   lineas 7380 y 16400). Datos inventados; las rutas no son reales. */
%let Servidor_LZ = lz_ficticia_08;
%let m_ambiente = D;

/* Etiqueta: Ambiente de la landing zone */
%macro ambiente;
%if &m_ambiente eq D %then
%do;

/* Desarrollo */
%let lz_dsn=IMPALA;
%end;
%else %if &m_ambiente eq C %then
%do;

/* Certi */
%let lz_dsn=IMPALAC;
%end;
%else %if &m_ambiente eq P %then
%do;

/* Produccion */
%let lz_dsn=IMPALAP;
%end;
%put &lz_dsn;
%mend ambiente;

%ambiente;

/* Etiqueta: Homologacion tdoc Nequi 1 */
PROC IMPORT
DATAFILE='\\servidor_ficticio\ENTRADAS_CORPUS\Homologacion_tpo_dto_Nequi.xlsx'
DBMS=EXCELCS OUT=WORK.Homologacion_tpo_dto_Nequi REPLACE;
TEXTSIZE=32767;
PORT=9621;
SERVER='servidor_ficticio';
SHEET='';
RUN;

/* Etiqueta: Importar Clientes Nequi */
TITLE "Tarea desarrollada por BANCOLOMBIA";
FOOTNOTE1 "Generated by BANCOLOMBIA (&SYSUSERID, &SYSSCPL) on %TRIM(%QSYSFUNC(DATE(), NLDATE20.)) at %TRIM(%SYSFUNC(TIME(), TIMEAMPM12.))";
%let server=servidor_ficticio 7551;
OPTIONS REMOTE=server COMAMID=TCP;
signon
user=&sysuserid pass='***';
RSUBMIT server;

/*PROCESO PARA CARGAR EL ARCHIVO DESDE PCFILE HACIA UNA RUTA TEMPORAL EN SAS*/
PROC DOWNLOAD INFILE='\\servidor_ficticio\ENTRADAS_CORPUS\DETALLE_NEQUI.csv'
OUTFILE='/work_sasstudio/pcfiles/DETALLE_NEQUI.csv';
endrsubmit;
signoff;
run;

/*PROCESO PARA IMPORTAR EL ARHCIVO DESDE LA RUTA TEMPORAL HACIA UNA LIBRERIA DE SAS*/
proc import datafile='/work_sasstudio/pcfiles/DETALLE_NEQUI.csv' out=WORK.DETALLE_NEQUI
dbms=dlm replace;
delimiter=';';
getnames=NO;
run;

/* Etiqueta: Nombre columnas Nequi */
%web_drop_table(WORK.SABANA_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.SABANA_NEQUI
AS
SELECT DETALLE_NEQUI.VAR1 AS ANIO_PROCESO, DETALLE_NEQUI.VAR2 AS MES_PROCESO,
DETALLE_NEQUI.VAR4 AS RELACION, DETALLE_NEQUI.VAR6 AS TIPO_CTA,
DETALLE_NEQUI.VAR7 AS NRO_CTA, DETALLE_NEQUI.VAR8 AS LLAVE_NOMBRE,
DETALLE_NEQUI.VAR9 AS TIPO_DOC, DETALLE_NEQUI.VAR10 AS NRO_DOC_TXT,
DETALLE_NEQUI.VAR11 AS GMF_TXT, DETALLE_NEQUI.VAR23 AS FIN_SALDO_CTA
FROM WORK.DETALLE_NEQUI DETALLE_NEQUI;
QUIT;

%web_open_table(WORK.SABANA_NEQUI);

/* Etiqueta: Convierte NRO_DOC a numero */
data work.temporal;
format NRO_DOC 30.;
set WORK.SABANA_NEQUI;
NRO_DOC=input(left(NRO_DOC_TXT), 30.);
drop NRO_DOC_TXT;
run;

data WORK.SABANA_NEQUI;
set work.temporal;
run;

proc delete data=work.temporal;
run;

/* Etiqueta: Convierte GMF a numero */
data work.temporal;
format GMF 3.;
set WORK.SABANA_NEQUI;
GMF=input(left(GMF_TXT), 3.);
drop GMF_TXT;
run;

data WORK.SABANA_NEQUI;
set work.temporal;
run;

proc delete data=work.temporal;
run;

/* Etiqueta: Tipo doc invalido Nequi */
%web_drop_table(WORK.TIPO_DOC_INVALIDO_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.TIPO_DOC_INVALIDO_NEQUI
AS
SELECT SABANA_NEQUI.RELACION, SABANA_NEQUI.TIPO_CTA, SABANA_NEQUI.NRO_CTA,
SABANA_NEQUI.LLAVE_NOMBRE, SABANA_NEQUI.TIPO_DOC, SABANA_NEQUI.NRO_DOC
FROM WORK.SABANA_NEQUI SABANA_NEQUI
LEFT JOIN WORK.Homologacion_tpo_dto_Nequi Homologacion_tpo_dto_Nequi
ON
   ( SABANA_NEQUI.TIPO_DOC = Homologacion_tpo_dto_Nequi.CNAME )
WHERE Homologacion_tpo_dto_Nequi.CNAME IS MISSING ;
QUIT;

%web_open_table(WORK.TIPO_DOC_INVALIDO_NEQUI);

/* Etiqueta: Tipo doc valido Nequi */
%web_drop_table(WORK.TIPO_DOC_VALIDO_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.TIPO_DOC_VALIDO_NEQUI
AS
SELECT SABANA_NEQUI.*
FROM WORK.SABANA_NEQUI SABANA_NEQUI
INNER JOIN WORK.Homologacion_tpo_dto_Nequi Homologacion_tpo_dto_Nequi
ON
   ( SABANA_NEQUI.TIPO_DOC = Homologacion_tpo_dto_Nequi.CNAME ) ;
QUIT;

%web_open_table(WORK.TIPO_DOC_VALIDO_NEQUI);

/* Etiqueta: tit-cot vacios o 0 Nequi */
%web_drop_table(WORK.NRO_DOC_VACIO_0_TIT_COT_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.NRO_DOC_VACIO_0_TIT_COT_NEQUI
AS
SELECT TIPO_DOC_VALIDO_NEQUI.*
FROM WORK.TIPO_DOC_VALIDO_NEQUI TIPO_DOC_VALIDO_NEQUI
WHERE
   (
      ( TIPO_DOC_VALIDO_NEQUI.NRO_DOC = 0 ) OR TIPO_DOC_VALIDO_NEQUI.NRO_DOC IS MISSING
   ) AND
   ( TIPO_DOC_VALIDO_NEQUI.RELACION <> 9902 ) ;
QUIT;

%web_open_table(WORK.NRO_DOC_VACIO_0_TIT_COT_NEQUI);

/* Etiqueta: FA cero Nequi */
%web_drop_table(WORK.INCONS_NRO_DOC_FA_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.INCONS_NRO_DOC_FA_NEQUI
AS
SELECT TIPO_DOC_VALIDO_NEQUI.*
FROM WORK.TIPO_DOC_VALIDO_NEQUI TIPO_DOC_VALIDO_NEQUI
WHERE
   (
      ( TIPO_DOC_VALIDO_NEQUI.NRO_DOC = 0 ) OR TIPO_DOC_VALIDO_NEQUI.NRO_DOC IS MISSING
   ) AND
   ( TIPO_DOC_VALIDO_NEQUI.RELACION = 9902 ) ;
QUIT;

%web_open_table(WORK.INCONS_NRO_DOC_FA_NEQUI);

/* Etiqueta: Sabana sin vacios o 0 Nequi */
%web_drop_table(WORK.SABANA_SIN_VACIOS_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.SABANA_SIN_VACIOS_NEQUI
AS
SELECT TIPO_DOC_VALIDO_NEQUI.*
FROM WORK.TIPO_DOC_VALIDO_NEQUI TIPO_DOC_VALIDO_NEQUI
WHERE TIPO_DOC_VALIDO_NEQUI.NRO_DOC IS NOT MISSING
  AND TIPO_DOC_VALIDO_NEQUI.NRO_DOC <> 0 ;
QUIT;

%web_open_table(WORK.SABANA_SIN_VACIOS_NEQUI);

/* Etiqueta: Sabana final Nequi */
%web_drop_table(WORK.SABANA_FINAL_NEQUI);

/* Código de query generado para SAS Studio por Common Query Services */

PROC SQL;
CREATE TABLE WORK.SABANA_FINAL_NEQUI
AS
SELECT DISTINCT SABANA_SIN_VACIOS_NEQUI.RELACION, SABANA_SIN_VACIOS_NEQUI.TIPO_CTA,
SABANA_SIN_VACIOS_NEQUI.NRO_CTA, SABANA_SIN_VACIOS_NEQUI.LLAVE_NOMBRE,
SABANA_SIN_VACIOS_NEQUI.TIPO_DOC, SABANA_SIN_VACIOS_NEQUI.NRO_DOC,
SABANA_SIN_VACIOS_NEQUI.GMF, SABANA_SIN_VACIOS_NEQUI.FIN_SALDO_CTA
FROM WORK.SABANA_SIN_VACIOS_NEQUI SABANA_SIN_VACIOS_NEQUI
LEFT JOIN WORK.TIPO_DOC_INVALIDO_NEQUI TIPO_DOC_INVALIDO_NEQUI
ON ( SABANA_SIN_VACIOS_NEQUI.LLAVE_NOMBRE = TIPO_DOC_INVALIDO_NEQUI.LLAVE_NOMBRE )
WHERE TIPO_DOC_INVALIDO_NEQUI.LLAVE_NOMBRE IS MISSING ;
QUIT;

%web_open_table(WORK.SABANA_FINAL_NEQUI);

/* Etiqueta: Consolidado de rechazos Nequi */
/*INICIA CÓDIGO*/
PROC SQL;
CREATE TABLE WORK.RECHAZOS_NEQUI AS
SELECT RELACION, TIPO_CTA, LLAVE_NOMBRE, TIPO_DOC, NRO_DOC, 'TIPO DOC INVALIDO' AS MOTIVO
FROM WORK.TIPO_DOC_INVALIDO_NEQUI
OUTER UNION CORR
SELECT RELACION, TIPO_CTA, LLAVE_NOMBRE, TIPO_DOC, NRO_DOC, 'NRO DOC VACIO O CERO' AS MOTIVO
FROM WORK.NRO_DOC_VACIO_0_TIT_COT_NEQUI
OUTER UNION CORR
SELECT RELACION, TIPO_CTA, LLAVE_NOMBRE, TIPO_DOC, NRO_DOC, 'NRO DOC FA VACIO O CERO' AS MOTIVO
FROM WORK.INCONS_NRO_DOC_FA_NEQUI;
QUIT;
/*FIN CÓDIGO*/

/* Etiqueta: Suma saldo sabana final Nequi */
data WORK.FORMAT_SABANA_FINAL_NEQUI;
format FORM_FIN_SALDO_CTA 20.;
set WORK.SABANA_FINAL_NEQUI;
FORM_FIN_SALDO_CTA=input(left(FIN_SALDO_CTA), 20.);
run;

PROC SQL;
CREATE TABLE WORK.SUMA_SALDO_NEQUI_FINAL AS
SELECT SUM(FORM_FIN_SALDO_CTA)
AS SUMA_SALDO_FINAL_NEQUI
FROM WORK.FORMAT_SABANA_FINAL_NEQUI;
QUIT;

/* Etiqueta: Conteo de validos y rechazos Nequi */
PROC SQL;
CREATE TABLE WORK.CONTEO_NEQUI AS
SELECT 'VALIDO' AS ESTADO, COUNT(*) AS NRO_FILAS FROM WORK.SABANA_FINAL_NEQUI
OUTER UNION CORR
SELECT 'RECHAZO' AS ESTADO, COUNT(*) AS NRO_FILAS FROM WORK.RECHAZOS_NEQUI;
QUIT;

/* Etiqueta: Exportar sabana final Nequi */
PROC EXPORT DATA=WORK.SABANA_FINAL_NEQUI
OUTFILE='/work_sasstudio/pcfiles/SABANA_FINAL_NEQUI.csv'
DBMS=DLM REPLACE;
DELIMITER=';';
PUTNAMES=NO;
RUN;

/* Etiqueta: Exportar rechazos Nequi */
PROC EXPORT DATA=WORK.RECHAZOS_NEQUI
OUTFILE='/work_sasstudio/pcfiles/RECHAZOS_NEQUI.csv'
DBMS=DLM REPLACE;
DELIMITER=';';
PUTNAMES=NO;
RUN;
