PROC IMPORT DATAFILE='.../entradas/REGISTROS.csv' OUT=WORK.REGISTROS DBMS=CSV REPLACE;
    GETNAMES=YES;
RUN;

DATA WORK.PRINCIPAL WORK.INTERMEDIA;
    SET WORK.REGISTROS;
    IF valor = 1 THEN OUTPUT WORK.PRINCIPAL;
    ELSE IF valor = 2 THEN OUTPUT WORK.INTERMEDIA;
    ELSE OUTPUT WORK.PRINCIPAL;
RUN;

PROC EXPORT DATA=WORK.PRINCIPAL OUTFILE='.../salida/PRINCIPAL.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.INTERMEDIA OUTFILE='.../salida/INTERMEDIA.csv' DBMS=CSV REPLACE;
RUN;
