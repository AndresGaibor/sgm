PROC IMPORT DATAFILE='.../entradas/REGISTROS.csv' OUT=WORK.REGISTROS DBMS=CSV REPLACE;
    GETNAMES=YES;
RUN;

DATA WORK.SALIDA_BAJA WORK.COPIA_BAJA WORK.SALIDA_ALTA;
    SET WORK.REGISTROS;
    IF VALOR <= 2 THEN OUTPUT WORK.SALIDA_BAJA WORK.COPIA_BAJA;
    ELSE IF VALOR >= 4 THEN OUTPUT WORK.SALIDA_ALTA;
RUN;

PROC EXPORT DATA=WORK.SALIDA_BAJA OUTFILE='.../salida/SALIDA_BAJA.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.COPIA_BAJA OUTFILE='.../salida/COPIA_BAJA.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.SALIDA_ALTA OUTFILE='.../salida/SALIDA_ALTA.csv' DBMS=CSV REPLACE;
RUN;
