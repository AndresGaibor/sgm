PROC IMPORT DATAFILE='.../entradas/REGISTROS.csv' OUT=WORK.REGISTROS DBMS=CSV REPLACE;
    GETNAMES=YES;
RUN;

DATA WORK.TEMPRANO WORK.TARDE WORK.FINAL;
    SET WORK.REGISTROS;
    IF valor = 1 THEN OUTPUT WORK.TEMPRANO;
    ELSE OUTPUT WORK.TARDE;
    valor = valor + 10;
    OUTPUT WORK.FINAL;
RUN;

PROC EXPORT DATA=WORK.TEMPRANO OUTFILE='.../salida/TEMPRANO.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.TARDE OUTFILE='.../salida/TARDE.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.FINAL OUTFILE='.../salida/FINAL.csv' DBMS=CSV REPLACE;
RUN;
