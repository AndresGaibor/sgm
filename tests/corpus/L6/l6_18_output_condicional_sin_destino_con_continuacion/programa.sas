PROC IMPORT DATAFILE='.../entradas/REGISTROS.csv' OUT=WORK.REGISTROS DBMS=CSV REPLACE;
    GETNAMES=YES;
RUN;

DATA WORK.PRIMERA WORK.SEGUNDA;
    SET WORK.REGISTROS;
    IF valor = 1 THEN OUTPUT;
    valor = valor + 10;
RUN;

PROC EXPORT DATA=WORK.PRIMERA OUTFILE='.../salida/PRIMERA.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.SEGUNDA OUTFILE='.../salida/SEGUNDA.csv' DBMS=CSV REPLACE;
RUN;
