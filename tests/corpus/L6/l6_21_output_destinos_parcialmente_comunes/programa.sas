PROC IMPORT DATAFILE='.../entradas/REGISTROS.csv' OUT=WORK.REGISTROS DBMS=CSV REPLACE;
    GETNAMES=YES;
RUN;

DATA WORK.PRIMERA WORK.COMUN WORK.OTROS;
    SET WORK.REGISTROS;
    IF valor = 1 THEN OUTPUT WORK.PRIMERA WORK.COMUN;
    ELSE OUTPUT WORK.COMUN WORK.OTROS;
RUN;

PROC EXPORT DATA=WORK.PRIMERA OUTFILE='.../salida/PRIMERA.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.COMUN OUTFILE='.../salida/COMUN.csv' DBMS=CSV REPLACE;
RUN;
PROC EXPORT DATA=WORK.OTROS OUTFILE='.../salida/OTROS.csv' DBMS=CSV REPLACE;
RUN;
