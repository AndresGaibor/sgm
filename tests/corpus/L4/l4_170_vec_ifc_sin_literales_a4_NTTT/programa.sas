/* Caso l4_170_vec_ifc_sin_literales_a4_NTTT: vector de semántica SAS verificado por el oráculo. */
PROC IMPORT DATAFILE='.../entradas/ENTRADA_L4.csv' OUT=WORK.ENTRADA_L4 DBMS=CSV REPLACE;
  GETNAMES=YES;
RUN;

DATA WORK.RESULTADO_L4;
  SET WORK.ENTRADA_L4;
  RESULTADO=ifc(CONDICION, VERDADERO, FALSO, FALTANTE);
RUN;

PROC EXPORT DATA=WORK.RESULTADO_L4 OUTFILE='.../salida/RESULTADO_L4.csv'
  DBMS=CSV REPLACE;
RUN;
