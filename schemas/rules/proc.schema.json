{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROC",
  "type": "object",
  "required": [
    "id",
    "kind",
    "version",
    "status",
    "proc",
    "ops",
    "tests"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "soportado",
        "parcial",
        "reemplazado",
        "hueco"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^tests/cases/"
      }
    },
    "proc": {
      "type": "string"
    },
    "ops": {
      "type": "array"
    }
  },
  "if": {
    "properties": { "ops": { "maxItems": 0 } },
    "required": ["ops"]
  },
  "then": {
    "properties": {
      "status": { "const": "parcial" },
      "fallback": {
        "type": "object",
        "required": ["reason", "note"],
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required": ["fallback"]
  },
  "additionalProperties": true
}
