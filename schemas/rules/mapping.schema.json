{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapeo a componente",
  "type": "object",
  "required": [
    "id",
    "version",
    "rung",
    "match",
    "emit",
    "confidence",
    "alternatives",
    "tests"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rung": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "match": {
      "type": "object"
    },
    "emit": {
      "type": "object",
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "enum": [
        "alta",
        "media",
        "baja"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^tests/cases/"
      }
    }
  },
  "additionalProperties": true
}
