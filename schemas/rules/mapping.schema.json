{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapeo a componente",
  "type": "object",
  "required": ["id", "version", "prioridad", "cuando", "produce", "confidence", "alternatives", "casos"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "prioridad": {"type": "integer", "minimum": 0, "maximum": 100},
    "cuando": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string"},
        "placement": {"type": "string"},
        "file_format": {"type": "string"}
      }
    },
    "produce": {
      "type": "object",
      "required": ["component"],
      "properties": {"component": {"type": "string"}}
    },
    "confidence": {"enum": ["alta", "media", "baja"]},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "casos": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^tests/cases/"}
    }
  },
  "additionalProperties": true
}
